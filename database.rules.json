{
  "rules": {
    ".read": false,
    ".write": false,
    "liste": {
      ".read": "auth != null",
      ".write": "auth != null",
      "artikel": {
        "$id": {
          ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 120"
        }
      }
    }
  }
}
